<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_tag_view_form_stockist" model="ir.ui.view">
        <field name="name">product.tag.form.stockist</field>
        <field name="model">product.tag</field>
        <field name="inherit_id" ref="product.product_tag_view_form"/>
        <field name="arch" type="xml">
            <field name="color" position="after">
                <field name="stockist_category"/>
            </field>
        </field>
    </record>

    <record id="product_tag_view_tree_stockist" model="ir.ui.view">
        <field name="name">product.tag.list.stockist</field>
        <field name="model">product.tag</field>
        <field name="inherit_id" ref="product.product_tag_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="stockist_category" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
