<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_account" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='total_amount_words']" position="before">
                <setting help="Blocking customer due to credit limit"
                    invisible="not account_use_credit_limit">
                    <field name="credit_control" />
                </setting>
                <setting help="Blocking customer due to invoice overdue">
                    <field name="overdue_control" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>