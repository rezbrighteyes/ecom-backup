<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_property_form_account" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='credit_limits']/field[@name='credit']" position="after">
                <field name="credit_due" readonly="True" />
            </xpath>
            <xpath expr="//group[@name='credit_limits']" position="inside">
                <field name="credit_control" invisible="not use_partner_credit_limit" />
                <field name="overdue_control" />
            </xpath>
        </field>
    </record>
</odoo>