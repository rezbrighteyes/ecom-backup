<odoo>
    <data>

        <record model="ir.module.category" id="group_category_advanced_session_management">
            <field name="name">Advanced Session Management</field>
        </record>

        <!-- Odoo 20: groups hang off a res.groups.privilege, not a category. -->
        <record id="privilege_advanced_session_management" model="res.groups.privilege">
            <field name="name">Advanced Session Management</field>
            <field name="category_id" ref="advanced_session_management.group_category_advanced_session_management"/>
        </record>

        <record id="group_login_log_user_ah" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="advanced_session_management.privilege_advanced_session_management"/>
        </record>
        

        <record id="group_login_log_admin_ah" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="advanced_session_management.privilege_advanced_session_management"/>
        </record>

        </data>
</odoo>
