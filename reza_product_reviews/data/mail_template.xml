<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_review_request" model="mail.template">
        <field name="name">Review Request</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="subject">How was your order from {{ object.company_id.name }}?</field>
        <field name="email_from">{{ object.company_id.email }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="body_html" type="html">
<div style="font-family:'Segoe UI', Roboto, Helvetica, Arial, sans-serif; max-width:600px; margin:0 auto; background:#F5F5F5;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td style="background:#1A1A1A; padding:40px 24px; text-align:center;">
        <h1 style="color:#C9A84A; font-size:26px; margin:0; font-weight:600;">How did we do?</h1>
        <p style="color:#BBBBBB; font-size:14px; margin:10px 0 0; line-height:1.5;">Your opinion matters. Help us improve and help others choose.</p>
      </td>
    </tr>
  </table>

  <table width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td style="padding:24px 16px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff; border-radius:12px;">
          <tr>
            <td style="padding:28px 24px;">

              <p style="color:#1A1A1A; font-size:16px; margin:0 0 8px;">Hi <strong><t t-out="object.partner_id.name">Customer</t></strong>,</p>
              <p style="color:#555555; font-size:14px; line-height:1.7; margin:0 0 24px;">Thank you for your recent order from <strong><t t-out="object.company_id.name">Our Store</t></strong>. We hope you're enjoying your purchase. We'd love to hear what you think.</p>

              <p style="font-size:11px; color:#888888; font-weight:700; text-transform:uppercase; letter-spacing:1.5px; margin:0 0 12px; border-bottom:2px solid #F0F0F0; padding-bottom:10px;">Your Order</p>

              <t t-foreach="object.order_line" t-as="line">
                <t t-if="line.product_id.type != 'service'">
                  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:12px; background:#FAFAFA; border-radius:10px; border:1px solid #EEEEEE;">
                    <tr>
                      <td style="padding:14px;">

                        <!-- Row 1: image + product info -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:12px;">
                          <tr>
                            <td width="72" style="vertical-align:top; padding-right:12px;">
                              <img t-att-src="'%s/web/image/product.product/%s/image_128' % (object.website_id.domain or object.company_id.website, line.product_id.id)" width="60" height="60" style="width:60px; height:60px; object-fit:cover; border-radius:8px; display:block; border:1px solid #EEEEEE;" alt=""/>
                            </td>
                            <td style="vertical-align:middle;">
                              <p style="margin:0 0 3px; font-size:14px; font-weight:600; color:#1A1A1A; line-height:1.4; word-break:break-word;"><t t-out="line.product_id.name"/></p>
                              <p style="margin:0; font-size:12px; color:#888888;">Qty: <t t-out="line.product_uom_qty"/></p>
                            </td>
                          </tr>
                        </table>

                        <!-- Row 2: button full width -->
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                          <tr>
                            <td style="text-align:center;">
                              <a t-att-href="'%s%s' % (object.website_id.domain or object.company_id.website, line.product_id.product_tmpl_id.website_url)" style="display:inline-block; background:#C9A84A; color:#FFFFFF; padding:12px 32px; border-radius:100px; text-decoration:none; font-size:14px; font-weight:600;">Leave a Review</a>
                            </td>
                          </tr>
                        </table>

                      </td>
                    </tr>
                  </table>
                </t>
              </t>

              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0 20px;">
                <tr><td style="border-top:1px solid #F0F0F0;"></td></tr>
              </table>

              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="text-align:center;">
                    <p style="margin:0 0 14px; font-size:13px; color:#555555;">Have feedback about your overall experience?</p>
                    <a t-att-href="'%s/contactus' % (object.website_id.domain or object.company_id.website)" style="display:inline-block; background:transparent; color:#1A1A1A; padding:10px 24px; border-radius:100px; text-decoration:none; font-size:13px; font-weight:600; border:2px solid #1A1A1A;">Contact Us</a>
                  </td>
                </tr>
              </table>

            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  <table width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td style="padding:0 16px 32px; text-align:center;">
        <p style="color:#999999; font-size:12px; margin:0 0 4px;"><strong style="color:#555555;"><t t-out="object.company_id.name"/></strong></p>
        <a t-att-href="object.website_id.domain or object.company_id.website" style="color:#C9A84A; text-decoration:none; font-size:12px;"><t t-out="object.website_id.domain or object.company_id.website"/></a>
        <p style="color:#BBBBBB; font-size:11px; margin:10px 0 0;">You're receiving this because you recently made a purchase.</p>
      </td>
    </tr>
  </table>

</div>
        </field>
    </record>
</odoo>