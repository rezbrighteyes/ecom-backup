<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_review_request" model="mail.template">
        <field name="name">Review Request</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="subject">How was your order from {{ object.company_id.name }}?</field>
        <field name="email_from">{{ object.company_id.email }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif; max-width:600px; margin:0 auto;">
  <table width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td style="background:#1A1A1A; padding:32px; text-align:center;">
        <h1 style="color:#C9A84A; font-size:24px; margin:0;">How did we do?</h1>
        <p style="color:#BBBBBB; font-size:14px; margin:8px 0 0;">We hope you love your recent purchase.</p>
      </td>
    </tr>
    <tr>
      <td style="background:#ffffff; padding:32px;">
        <p style="color:#333; font-size:15px;">Hi <strong><t t-out="object.partner_id.name"/></strong>,</p>
        <p style="color:#555; font-size:14px; line-height:1.7;">Thank you for your recent order from <t t-out="object.company_id.name"/>. We would love to hear what you think.</p>
        <p style="font-size:13px; color:#777; font-weight:600; text-transform:uppercase; letter-spacing:1px;">Your order</p>
        <t t-foreach="object.order_line" t-as="line">
          <t t-if="line.product_id.type != 'service'">
            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:12px; border-radius:8px; border:1px solid #eee;">
              <tr>
                <td style="padding:12px; font-size:14px; font-weight:600; color:#1A1A1A;"><t t-out="line.product_id.name"/></td>
                <td style="padding:12px; text-align:right;">
                  <a t-attf-href="{{ line.product_id.product_tmpl_id.website_url }}" style="display:inline-block; background:#C9A84A; color:#fff; padding:8px 16px; border-radius:100px; text-decoration:none; font-size:12px; font-weight:600;">Leave a Review</a>
                </td>
              </tr>
            </table>
          </t>
        </t>
        <p style="color:#888; font-size:12px; margin-top:24px;">If you leave a review we will send you a 10% discount code for your next order.</p>
      </td>
    </tr>
    <tr>
      <td style="background:#1A1A1A; padding:24px; text-align:center;">
        <p style="color:#777; font-size:11px; margin:0;"><t t-out="object.company_id.name"/> &#160;&#183;&#160; <t t-out="object.company_id.website"/></p>
      </td>
    </tr>
  </table>
</div>
        </field>
    </record>
</odoo>