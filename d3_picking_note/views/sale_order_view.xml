<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_sale" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='note_group']/group" position="after">
                <group colspan="4" class="order-1 order-lg-0">
                    <field colspan="2" name="picking_note" nolabel="1" placeholder="Picking Notes..."/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>