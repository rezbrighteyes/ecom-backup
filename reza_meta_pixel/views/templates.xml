<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ViewContent on product page -->
    <template id="product_pixel" inherit_id="website_sale.product">
        <xpath expr="//section[@id='product_detail']" position="before">
            <script type="text/javascript">
                window.addEventListener('load', function() {
                    if (typeof fbq !== 'undefined') {
                        fbq('track', 'ViewContent', {
                            content_ids: ['<t t-out="product.id"/>'],
                            content_name: '<t t-out="product.name"/>',
                            content_type: 'product',
                            value: <t t-out="product.list_price"/>,
                            currency: '<t t-out="website.currency_id.name"/>'
                        });
                    }
                });
            </script>
        </xpath>
    </template>

    <!-- Inject customer data for Advanced Matching -->
    <template id="advanced_matching_data" inherit_id="website.layout">
        <xpath expr="//head" position="inside">
            <t t-if="request.env.user and not request.env.user._is_public()">
                <script type="application/json" id="fb_advanced_match_data">
                    <t t-out="request.env.user.partner_id.get_fb_advanced_match()"/>
                </script>
            </t>
        </xpath>
    </template>
</odoo>
