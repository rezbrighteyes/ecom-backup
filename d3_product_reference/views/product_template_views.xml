<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_tree_view_product" model="ir.ui.view">
        <field name="name">product.template.view.list.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="second_reference" optional="show" />
            </xpath>
        </field>
    </record>

    <record id="product_template_only_form_view_product" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="second_reference" invisible="product_variant_count &gt; 1" />
            </xpath>
        </field>
    </record>

    <record id="product_template_kanban_view_product" model="ir.ui.view">
        <field name="name">product.template.view.kanban.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view" />
        <field name="arch" type="xml">
            <xpath expr="//span[@t-if='record.default_code.value']" position="after">
                <span t-if="record.second_reference.value"> [<field name="second_reference" />] </span>
            </xpath>
        </field>
    </record>

    <record id="product_template_view_activity_product" model="ir.ui.view">
        <field name="name">product.template.view.kanban.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_view_activity" />
        <field name="arch" type="xml">
            <xpath expr="//div[@t-if='record.default_code.value']" position="after">
                <div t-if="record.second_reference.value" class="o_text_block text-muted"> [<field
                        name="second_reference" />] </div>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_product" model="ir.ui.view">
        <field name="name">product.template.view.search.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="replace">
                <field name="name" string="Product"
                    filter_domain="['|', '|', '|', '|', '|', ('default_code', 'ilike', self), ('second_reference', 'ilike', self), ('product_variant_ids.default_code', 'ilike', self), ('product_variant_ids.second_reference', 'ilike', self), ('name', 'ilike', self), ('barcode', 'ilike', self)]" />
            </xpath>
        </field>
    </record>
</odoo>