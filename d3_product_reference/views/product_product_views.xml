<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_variant_easy_edit_view_product" model="ir.ui.view">
        <field name="name">product.product.view.form.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="second_reference"/>
            </xpath>
        </field>
    </record>

    <record id="product_product_tree_view_product" model="ir.ui.view">
        <field name="name">product.product.view.list.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="second_reference" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="product_product_view_tree_tag_product" model="ir.ui.view">
        <field name="name">product.product.view.list.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_view_tree_tag"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="second_reference" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="product_normal_form_view_product" model="ir.ui.view">
        <field name="name">product.product.view.list.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="second_reference"/>
            </xpath>
        </field>
    </record>

    <record id="product_kanban_view_product" model="ir.ui.view">
        <field name="name">product.product.view.kanban.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//span[@t-if='record.default_code.value']" position="after">
                <span t-if="record.second_reference.value">
                    [<field name="second_reference"/>]
                </span>
            </xpath>
        </field>
    </record>

    <record id="product_product_view_activity_product" model="ir.ui.view">
        <field name="name">product.product.view.activity.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_view_activity"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="second_reference"/>
            </xpath>
            <!-- <xpath expr="//span[@t-if='record.default_code.value']" position="after">
                <span t-if="record.second_reference.value">
                    [<field name="second_reference"/>]
                </span>
            </xpath> -->
        </field>
    </record>

    <record id="product_view_kanban_catalog_product" model="ir.ui.view">
        <field name="name">product.product.view.activity.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_view_kanban_catalog"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="second_reference"/>
            </xpath>
            <xpath expr="//div[@t-if='record.default_code.value']" position="after">
                <div t-if="record.second_reference.value">
                    [<field name="second_reference"/>]
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_search_form_view_product" model="ir.ui.view">
        <field name="name">product.product.view.search.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="replace">
                <field name="name" string="Product" filter_domain="['|', '|', '|', ('default_code', 'ilike', self), ('second_reference', 'ilike', self), ('name', 'ilike', self), ('barcode', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>
</odoo>