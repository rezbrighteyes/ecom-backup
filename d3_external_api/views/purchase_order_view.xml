<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_purchase" model="ir.ui.view">
        <field name="name">purchase.order.view.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase_delivery_invoice']/group" position="inside">
                <group name="other_info">
                    <field name="external_api_purchase" invisible="True" />
                    <field name="external_api" string="Send though External API"
                        readonly="state in ('purchase', 'done', 'cancel')"
                        invisible="not external_api_purchase" />
                    <field name="external_api_sale" readonly="True"
                        invisible="not external_api or not external_api_sale" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>