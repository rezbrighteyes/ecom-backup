<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_reza_rma_form" model="ir.ui.view">
        <field name="name">product.template.reza.rma.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group string="Returns" name="reza_returns">
                    <field name="rma_return_method"/>
                    <field name="reza_non_returnable"/>
                    <field
                        name="reza_return_policy_note"
                        placeholder="Example: Clearance item - not eligible for return"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
