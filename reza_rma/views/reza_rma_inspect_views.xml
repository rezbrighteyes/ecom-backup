<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_reza_rma_inspect_wizard_form" model="ir.ui.view">
        <field name="name">reza.rma.inspect.wizard.form</field>
        <field name="model">reza.rma.inspect.wizard</field>
        <field name="arch" type="xml">
            <form string="Record Inspection">
                <sheet>
                    <group>
                        <field name="rma_id" readonly="1"/>
                        <field name="inspection_outcome" required="1"/>
                        <field name="disposition" required="1"/>
                        <field name="inspection_notes" placeholder="Optional notes for staff records"/>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
