<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="reason_defective" model="reza.rma.reason">
            <field name="name">Defective / Faulty Item</field>
            <field name="code">DEFECTIVE</field>
            <field name="sequence">10</field>
            <field name="requires_attachment" eval="True"/>
            <field name="customer_selectable" eval="True"/>
        </record>

        <record id="reason_wrong_item" model="reza.rma.reason">
            <field name="name">Wrong Item Received</field>
            <field name="code">WRONG_ITEM</field>
            <field name="sequence">20</field>
            <field name="requires_attachment" eval="True"/>
            <field name="customer_selectable" eval="True"/>
        </record>

        <record id="reason_transit_damage" model="reza.rma.reason">
            <field name="name">Damaged in Transit</field>
            <field name="code">TRANSIT_DMG</field>
            <field name="sequence">30</field>
            <field name="requires_attachment" eval="True"/>
            <field name="customer_selectable" eval="True"/>
        </record>

        <record id="reason_change_of_mind" model="reza.rma.reason">
            <field name="name">Change of Mind</field>
            <field name="code">CHANGE_MIND</field>
            <field name="sequence">40</field>
            <field name="requires_attachment" eval="False"/>
            <field name="customer_selectable" eval="True"/>
        </record>

        <record id="reason_wrong_size" model="reza.rma.reason">
            <field name="name">Wrong Size / Fit</field>
            <field name="code">WRONG_SIZE</field>
            <field name="sequence">50</field>
            <field name="requires_attachment" eval="False"/>
            <field name="customer_selectable" eval="True"/>
        </record>

        <record id="reason_missing_parts" model="reza.rma.reason">
            <field name="name">Missing Parts / Incomplete</field>
            <field name="code">MISSING</field>
            <field name="sequence">60</field>
            <field name="requires_attachment" eval="True"/>
            <field name="customer_selectable" eval="True"/>
        </record>

        <record id="reason_warranty" model="reza.rma.reason">
            <field name="name">Warranty Claim</field>
            <field name="code">WARRANTY</field>
            <field name="sequence">70</field>
            <field name="requires_attachment" eval="True"/>
            <field name="customer_selectable" eval="True"/>
            <field name="allowed_resolution">exchange</field>
        </record>

    </data>
</odoo>
