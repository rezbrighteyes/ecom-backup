<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Template 1: Submitted -->
    <record id="mail_template_rma_submitted" model="mail.template">
        <field name="name">RMA: Submitted Confirmation</field>
        <field name="model_id" ref="rma.model_rma"/>
        <field name="subject">Return Request Received — {{ object.name }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <p>Hi <t t-out="object.partner_id.name"/>,</p>
            <p>We have received your return request for <strong><t t-out="object.product_id.name"/></strong>.</p>
            <table width="100%" cellpadding="0" cellspacing="0" style="margin:1rem 0;">
                <tr>
                    <td style="background:#f0f4f8;border:1.5px solid #c7d9eb;border-radius:8px;padding:12px 16px;">
                        <div style="color:#888;font-size:11px;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;">Your Return Reference</div>
                        <div style="font-size:20px;font-weight:700;color:#1a3a5c;"><t t-out="object.name"/></div>
                        <div style="color:#888;font-size:11px;margin-top:4px;">Keep this reference number — you'll need it to track your return.</div>
                    </td>
                </tr>
            </table>
            <t t-if="object.reza_return_label_attachment_id">
                <p>Your prepaid Australia Post return label is attached to this email and also available to download below.</p>
                <p>
                    <strong>Next steps:</strong><br/>
                    1. Print the return label attached to this email<br/>
                    2. Pack the item securely in its original packaging with all tags attached<br/>
                    3. Drop the parcel at any Australia Post outlet
                </p>
                <p>
                    <a t-attf-href="{{ object.get_base_url() }}/my/rmas/{{ object.id }}/label">Download return label</a>
                </p>
                <t t-if="object.reza_return_shipping_fee">
                    <p>A return shipping fee of <strong><t t-out="object.company_id.currency_id.symbol"/><t t-out="object.reza_return_shipping_fee"/></strong> will be deducted from your refund — no upfront payment required.</p>
                </t>
            </t>
            <t t-else="">
                <p>Your return label is being generated and will be emailed to you shortly. You can also track your return online.</p>
            </t>
            <p>Once we receive and inspect the returned item, we will process your
                <t t-if="object.reza_operation_type == 'credit_note'">refund</t>
                <t t-if="object.reza_operation_type == 'store_credit'">store credit</t>
                <t t-if="object.reza_operation_type == 'exchange'">exchange</t>
                within 2 business days.
            </p>
            <p>
                <a t-attf-href="{{ object.get_base_url() }}/returns/request/{{ object.reza_request_line_id.request_id.portal_access_token }}">Track your return</a>
            </p>
            <p>Thank you,<br/><t t-out="object.company_id.name"/></p>
        </field>
    </record>

    <!-- Template 2: Approved — AusPost -->
    <record id="mail_template_rma_approved_auspost" model="mail.template">
        <field name="name">RMA: Approved — AusPost Return</field>
        <field name="model_id" ref="rma.model_rma"/>
        <field name="subject">Return Approved — {{ object.name }} — Please Post Your Item</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <p>Hi <t t-out="object.partner_id.name"/>,</p>
            <p>Your return request <strong><t t-out="object.name"/></strong> has been approved.</p>
            <t t-if="object.reza_return_label_attachment_id">
                <p>Your Australia Post return label is ready.</p>
                <p>
                    <a t-attf-href="{{ object.get_base_url() }}/my/rmas/{{ object.id }}/label">Download your return label</a>
                </p>
            </t>
            <t t-else="">
                <p>Your Australia Post return label is being prepared and will appear in your return portal shortly.</p>
            </t>
            <p>Pack the item securely in its original packaging with all tags attached.</p>
            <p>Please include your return reference <strong><t t-out="object.name"/></strong> inside the parcel.</p>
            <p>Once we receive and inspect the item we will process your
                <t t-if="object.reza_operation_type == 'credit_note'">refund</t>
                <t t-if="object.reza_operation_type == 'store_credit'">store credit</t>
                <t t-if="object.reza_operation_type == 'exchange'">exchange</t>
                within 2 business days.
            </p>
            <p><a t-attf-href="/my/rmas/{{ object.id }}">Track your return</a></p>
            <p>Thank you,<br/><t t-out="object.company_id.name"/></p>
        </field>
    </record>

    <!-- Template 3: Approved — Manual Address -->
    <record id="mail_template_rma_approved_manual" model="mail.template">
        <field name="name">RMA: Approved — Manual Return Address</field>
        <field name="model_id" ref="rma.model_rma"/>
        <field name="subject">Return Approved — {{ object.name }} — Return Address Inside</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <p>Hi <t t-out="object.partner_id.name"/>,</p>
            <p>Your return request <strong><t t-out="object.name"/></strong> has been approved.</p>
            <p>This item is not eligible for the Australia Post Returns Portal.
               Please send your item to the address below using your local post office.
               <strong>Return shipping is at your own expense.</strong>
            </p>
            <p>
                <strong>Return Address:</strong><br/>
                <t t-out="object.company_id.name"/><br/>
                <t t-out="object.company_id.street"/><br/>
                <t t-out="object.company_id.city"/> <t t-out="object.company_id.state_id.name"/> <t t-out="object.company_id.zip"/><br/>
                <t t-out="object.company_id.country_id.name"/>
            </p>
            <p>Please write your return reference <strong><t t-out="object.name"/></strong> clearly on the outside of the parcel.</p>
            <p>Once we receive and inspect the item we will process your outcome within 2 business days.</p>
            <p><a t-attf-href="/my/rmas/{{ object.id }}">Track your return</a></p>
            <p>Thank you,<br/><t t-out="object.company_id.name"/></p>
        </field>
    </record>

    <!-- Template 4: Rejected -->
    <record id="mail_template_rma_rejected" model="mail.template">
        <field name="name">RMA: Rejected</field>
        <field name="model_id" ref="rma.model_rma"/>
        <field name="subject">Update on Your Return Request {{ object.name }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <p>Hi <t t-out="object.partner_id.name"/>,</p>
            <p>Unfortunately we are unable to process your return request <strong><t t-out="object.name"/></strong>
               at this time.</p>
            <p>If you have any questions, please reply to this email or contact our customer service team.</p>
            <p>Thank you,<br/><t t-out="object.company_id.name"/></p>
        </field>
    </record>

    <!-- Template 5: Damaged / Used — return to customer -->
    <record id="mail_template_rma_damaged_return" model="mail.template">
        <field name="name">RMA: Damaged/Used — Item Being Returned to Customer</field>
        <field name="model_id" ref="rma.model_rma"/>
        <field name="subject">Update on Return Request {{ object.name }} — Item Condition</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <p>Hi <t t-out="object.partner_id.name"/>,</p>
            <p>Thank you for sending your item back for return request <strong><t t-out="object.name"/></strong>.</p>
            <p>Upon inspection our team found that the item shows signs of wear, use, or damage.
               As per our returns policy, damaged or used items are not eligible for a refund,
               exchange, or store credit.</p>
            <p>Your item will be posted back to you. Our team will be in touch regarding the return shipping cost.</p>
            <p>If you believe this is an error, please contact our customer service team and
               quote reference <strong><t t-out="object.name"/></strong>.</p>
            <p>Thank you,<br/><t t-out="object.company_id.name"/></p>
        </field>
    </record>

    <!-- Template 6: Done / Closed -->
    <record id="mail_template_rma_done" model="mail.template">
        <field name="name">RMA: Closed</field>
        <field name="model_id" ref="rma.model_rma"/>
        <field name="subject">Return {{ object.name }} — Processed</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <p>Hi <t t-out="object.partner_id.name"/>,</p>
            <p>Your return request <strong><t t-out="object.name"/></strong> has been processed and closed.</p>
            <t t-if="object.reza_operation_type == 'credit_note'">
                <p>A refund has been issued to your original payment method.
                   Please allow 3–5 business days for the funds to appear in your account.</p>
            </t>
            <t t-if="object.reza_operation_type == 'store_credit'">
                <p>A store credit has been applied to your account and is available for your next purchase.</p>
                <t t-if="object.reza_store_credit_bonus_amount">
                    <p>Your first-return bonus added an extra
                        <strong><t t-out="object.company_id.currency_id.symbol"/><t t-out="object.reza_store_credit_bonus_amount"/></strong>
                        in store credit.</p>
                </t>
            </t>
            <t t-if="object.reza_operation_type == 'exchange'">
                <p>Your replacement has been arranged. You will receive a separate shipping confirmation.</p>
            </t>
            <p>Thank you,<br/><t t-out="object.company_id.name"/></p>
        </field>
    </record>

</odoo>
