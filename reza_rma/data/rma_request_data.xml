<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_reza_rma_request" model="ir.sequence">
        <field name="name">Return Request</field>
        <field name="code">reza.rma.request</field>
        <field name="prefix">RET/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="ir_cron_reza_rma_retry_failed_labels" model="ir.cron">
        <field name="name">RMA: Retry Failed Return Labels</field>
        <field name="model_id" ref="model_reza_rma_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_retry_failed_labels()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
    </record>

    <record id="ir_cron_reza_rma_expire_exchange_holds" model="ir.cron">
        <field name="name">RMA: Expire Exchange Holds</field>
        <field name="model_id" ref="model_reza_rma_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_exchange_holds()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_reza_rma_purge_lookup_attempts" model="ir.cron">
        <field name="name">RMA: Purge Guest Lookup Attempts</field>
        <field name="model_id" ref="model_reza_rma_lookup_attempt"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
