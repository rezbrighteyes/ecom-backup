<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rz_storefront_website_form" model="ir.ui.view">
        <field name="name">website.form.storefront</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Storefront" name="rz_storefront" groups="website.group_website_designer">
                    <group>
                        <group>
                            <button name="action_rz_storefront_refresh" type="object"
                                    string="Refresh storefront now" class="btn-primary" colspan="2"/>
                            <field name="rz_storefront_refresh_requested_at"/>
                        </group>
                        <group>
                            <field name="rz_storefront_status" nolabel="1" colspan="2"/>
                        </group>
                    </group>
                    <group string="Menu">
                        <group>
                            <field name="rz_storefront_use_odoo_menu"/>
                            <button name="action_rz_storefront_menu" type="object"
                                    string="Edit storefront menu" class="btn-secondary" colspan="2"/>
                        </group>
                    </group>
                    <label for="rz_storefront_featured_brand_ids"/>
                    <field name="rz_storefront_featured_brand_ids" context="{'active_test': False}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="brand_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
