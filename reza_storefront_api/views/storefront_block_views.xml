<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rz_storefront_block_view_list" model="ir.ui.view">
        <field name="name">reza.storefront.block.list</field>
        <field name="model">reza.storefront.block</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="website_id"/>
                <field name="slot"/>
                <field name="page_key" optional="hide"/>
                <field name="category_id" optional="hide"/>
                <field name="kind"/>
                <field name="date_start" optional="show"/>
                <field name="date_end" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'published'"/>
                <field name="is_live"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="rz_storefront_block_view_form" model="ir.ui.view">
        <field name="name">reza.storefront.block.form</field>
        <field name="model">reza.storefront.block</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Summer hero"/></h1>
                    </div>
                    <group>
                        <group string="Where">
                            <field name="website_id"/>
                            <field name="slot"/>
                            <field name="page_key" invisible="slot != 'page.top'" required="slot == 'page.top'"/>
                            <field name="category_id" invisible="slot != 'category.banner'"/>
                            <field name="sequence"/>
                        </group>
                        <group string="When (UTC)">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="is_live"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <group string="Content">
                            <field name="kind"/>
                            <field name="headline"/>
                            <field name="body"/>
                            <field name="button_label"/>
                            <field name="link" placeholder="/shop/category/sunglasses or https://..."/>
                            <field name="alt_text" required="kind in ('image', 'video')"/>
                        </group>
                        <group string="Media">
                            <field name="image_desktop" widget="image" options="{'preview_image': 'image_desktop_640'}"
                                   invisible="kind == 'text'" required="kind == 'image'"/>
                            <field name="image_mobile" widget="image" options="{'preview_image': 'image_mobile_720'}"
                                   invisible="kind != 'image'"/>
                            <field name="video" filename="video_filename" invisible="kind != 'video'"
                                   required="kind == 'video'"/>
                            <field name="video_filename" invisible="1"/>
                            <field name="video_poster" widget="image" invisible="kind != 'video'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rz_storefront_block_view_search" model="ir.ui.view">
        <field name="name">reza.storefront.block.search</field>
        <field name="model">reza.storefront.block</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="website_id"/>
                <field name="slot"/>
                <filter name="live" string="Live now" domain="[('is_live', '=', True)]"/>
                <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="by_website" string="Website" context="{'group_by': 'website_id'}"/>
                    <filter name="by_slot" string="Slot" context="{'group_by': 'slot'}"/>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="rz_storefront_block_action" model="ir.actions.act_window">
        <field name="name">Storefront content</field>
        <field name="res_model">reza.storefront.block</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="rz_storefront_block_view_search"/>
    </record>

    <menuitem id="rz_storefront_menu" name="Storefront"
              parent="website.menu_website_configuration" sequence="60"
              groups="base.group_user"/>
    <menuitem id="rz_storefront_block_menu" name="Content"
              parent="rz_storefront_menu" action="rz_storefront_block_action" sequence="10"/>
</odoo>
