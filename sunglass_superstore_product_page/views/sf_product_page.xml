<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="ss_stock_urgency"
              inherit_id="website_sale.cta_wrapper"
              name="SS: Stock Urgency"
              priority="25">
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="after">
            <t t-set="stock_msg" t-value="product._sf_get_stock_message()"/>
            <div t-if="stock_msg" class="sf-stock-urgency mt-2 mb-2">
                <span class="badge bg-warning text-dark">
                    <i class="oi me-1" data-icon="whatshot"/>
                    <t t-out="stock_msg"/>
                </span>
            </div>
        </xpath>
    </template>

    <template id="ss_trust_badges"
              inherit_id="website_sale.product"
              name="SS: Trust Badges"
              priority="25">
        <xpath expr="//t[@t-call='website_sale.documents']" position="after">
            <div class="sf-trust-row my-3">
                <t t-set="ship_threshold" t-value="product._sf_get_shipping_threshold()"/>
                <div class="row g-2">
                    <div class="col-4">
                        <div class="sf-trust-badge text-center p-2 rounded">
                            <i class="oi mb-1 d-block" data-icon="local_shipping" style="font-size: 18px; color: #1D9E75;"/>
                            <small class="text-muted d-block" style="font-size: 11px; line-height: 1.3;">Free shipping over $<t t-out="ship_threshold"/></small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="sf-trust-badge text-center p-2 rounded">
                            <i class="oi mb-1 d-block" data-icon="refresh" style="font-size: 18px; color: #378ADD;"/>
                            <small class="text-muted d-block" style="font-size: 11px; line-height: 1.3;">30-day returns</small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="sf-trust-badge text-center p-2 rounded">
                            <t t-set="sf_qty" t-value="product._sf_get_stock_qty()"/>
                            <i t-if="sf_qty &gt; 0" class="oi oi-filled mb-1 d-block" data-icon="check_circle" style="font-size: 18px; color: #1D9E75;"/>
                            <i t-else="" class="oi oi-filled mb-1 d-block" data-icon="cancel" style="font-size: 18px; color: #E24B4A;"/>
                            <small class="text-muted d-block" style="font-size: 11px; line-height: 1.3;">
                                <t t-if="sf_qty &gt; 0">In stock</t>
                                <t t-else="">Out of stock</t>
                            </small>
                        </div>
                    </div>
                </div>
                <t t-set="sf_qty_check" t-value="product._sf_get_stock_qty()"/>
                <div t-if="sf_qty_check &gt; 0" class="sf-delivery-estimate mt-2 p-2 rounded bg-light text-center">
                    <small class="text-muted">
                        <i class="oi me-1" data-icon="event_available"/>
                        Estimated delivery: <strong class="text-dark"><t t-out="product._sf_get_delivery_date()"/></strong>
                    </small>
                </div>
            </div>
        </xpath>
    </template>

    <template id="ss_mobile_accordion"
              inherit_id="website_sale.product"
              name="SS: Mobile Accordion"
              priority="30">
        <xpath expr="//t[@t-call='website_sale.container_dropzone_below_product_details']" position="before">
            <div id="ss_mobile_accordion_section" class="ss-mobile-accordion d-lg-none mt-3">
                <t t-set="seo_body_override" t-value="product._seo_body_override()"/>
                <t t-set="d3_has_description" t-value="seo_body_override or product.description_ecommerce or product.website_description"/>
                <t t-set="d3_general_specs" t-value="product._d3_get_visible_product_specs('general')"/>
                <div class="accordion accordion-flush">
                    <div t-if="d3_has_description" class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button fw-medium"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#ss_mob_collapse_description"
                                    aria-expanded="true"
                                    aria-controls="ss_mob_collapse_description">
                                <span class="ss-accordion-label">Description</span>
                            </button>
                        </h2>
                        <div id="ss_mob_collapse_description" class="accordion-collapse collapse show">
                            <div class="accordion-body">
                                <div t-if="seo_body_override"
                                     t-out="seo_body_override"
                                     class="mb-2 o_not_editable"/>
                                <div t-if="not seo_body_override and product.description_ecommerce"
                                     t-field="product.description_ecommerce"
                                     class="mb-2 oe_structure"
                                     placeholder="Add a product description here."/>
                                <div t-if="not seo_body_override and not product.description_ecommerce and product.website_description"
                                     t-field="product.website_description"
                                     class="mb-2 oe_structure"
                                     placeholder="Add a product description here."/>
                            </div>
                        </div>
                    </div>
                    <div t-if="d3_general_specs" class="accordion-item">
                        <h2 class="accordion-header">
                            <button t-attf-class="accordion-button fw-medium #{d3_has_description and 'collapsed' or ''}"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#ss_mob_collapse_specifications"
                                    t-att-aria-expanded="not d3_has_description and 'true' or 'false'"
                                    aria-controls="ss_mob_collapse_specifications">
                                <span class="ss-accordion-label">Specifications</span>
                            </button>
                        </h2>
                        <div id="ss_mob_collapse_specifications"
                             t-attf-class="accordion-collapse collapse #{not d3_has_description and 'show' or ''}">
                            <div class="accordion-body">
                                <t t-set="d3_specs_group" t-value="'general'"/>
                                <t t-call="d3_website_product_extended.product_specs_table"/>
                            </div>
                        </div>
                    </div>
                    <t t-set="d3_size_specs" t-value="product._d3_get_visible_product_specs('size')"/>
                    <div t-if="d3_size_specs" class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-medium"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#ss_mob_collapse_size"
                                    aria-expanded="false"
                                    aria-controls="ss_mob_collapse_size">
                                <span class="ss-accordion-label">Size &amp; Fit</span>
                            </button>
                        </h2>
                        <div id="ss_mob_collapse_size" class="accordion-collapse collapse">
                            <div class="accordion-body">
                                <t t-set="d3_specs_group" t-value="'size'"/>
                                <t t-call="d3_website_product_extended.product_specs_table"/>
                            </div>
                        </div>
                    </div>
                    <t t-set="d3_material_specs" t-value="product._d3_get_visible_product_specs('material')"/>
                    <div t-if="d3_material_specs" class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-medium"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#ss_mob_collapse_material"
                                    aria-expanded="false"
                                    aria-controls="ss_mob_collapse_material">
                                <span class="ss-accordion-label">Material &amp; Care</span>
                            </button>
                        </h2>
                        <div id="ss_mob_collapse_material" class="accordion-collapse collapse">
                            <div class="accordion-body">
                                <t t-set="d3_specs_group" t-value="'material'"/>
                                <t t-call="d3_website_product_extended.product_specs_table"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
