<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="product_ss_scope"
              name="SS: Scope Class"
              inherit_id="website_sale.product"
              priority="10">
        <xpath expr="//section[@id='product_detail']" position="attributes">
            <attribute name="t-attf-class" add="ss-theme" separator=" "/>
        </xpath>
    </template>

    <template id="product_collection_label"
              name="SS: Collection Label"
              inherit_id="website_sale.product"
              priority="20">
        <xpath expr="//h1[@itemprop='name']" position="before">
            <t t-if="product.public_categ_ids">
                <p class="ss-collection-label text-uppercase fw-semibold mb-1">
                    <t t-out="product.public_categ_ids[0].name"/>
                </p>
            </t>
        </xpath>
    </template>

    <template id="product_price_badge"
              name="SS: Discount Badge"
              inherit_id="website_sale.product"
              priority="20">
        <xpath expr="//t[@t-call='website_sale.product_price']" position="after">
            <t t-if="combination_info.get('has_discounted_price')
                     and combination_info.get('list_price')
                     and combination_info.get('price')">
                <t t-set="ss_pct"
                   t-value="round((1 - combination_info['price'] / combination_info['list_price']) * 100)"/>
                <t t-if="ss_pct > 0">
                    <span class="badge ss-off-badge ms-2 align-self-center px-2 py-1">
                        <t t-out="'%d%% OFF' % ss_pct"/>
                    </span>
                </t>
            </t>
        </xpath>
    </template>

    <template id="product_payment_methods"
              name="SS: Payment Methods"
              inherit_id="website_sale.product"
              priority="20">
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="after">
            <div class="ss-payment border-top border-bottom py-3 my-2">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="ss-pay-title small fw-semibold text-uppercase">
                        Pay it in 4 / Installment Overtime?
                    </span>
                    <i class="fa fa-chevron-down small text-muted"/>
                </div>
                <div class="d-flex flex-wrap gap-4">
                    <span class="ss-pay-badge small fw-bold text-uppercase">
                        <i class="fa fa-check-circle me-1"/> AFTERPAY
                    </span>
                    <span class="ss-pay-badge small fw-bold text-uppercase">
                        <i class="fa fa-check-circle me-1"/> PAYPAL
                    </span>
                    <span class="ss-pay-badge small fw-bold text-uppercase">
                        <i class="fa fa-check-circle me-1"/> ZIP
                    </span>
                </div>
            </div>
        </xpath>
    </template>

    <template id="product_accordion_custom"
              name="SS: Remove Accordion From Right Column"
              inherit_id="website_sale.product"
              priority="20">
        <xpath expr="//t[@t-call='website_sale.product_accordion']" position="replace">
        </xpath>
    </template>

    <template id="product_hide_inline_description"
              name="SS: Hide Inline Description"
              inherit_id="website_sale.product"
              priority="20">
        <xpath expr="//div[@t-field='product.description_ecommerce']" position="replace">
        </xpath>
    </template>

    <template id="product_fullwidth_accordion"
              name="SS: Accordion Below Image"
              inherit_id="website_sale.product"
              priority="30">
        <xpath expr="//t[@t-call='website_sale.shop_product_images']" position="after">
            <div id="ss_product_accordion_section" class="ss-left-accordion mt-3">
                <div id="product_accordion" class="accordion accordion-flush">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button fw-medium"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#ss_collapse_details"
                                    aria-expanded="true"
                                    aria-controls="ss_collapse_details">
                                <span class="ss-accordion-label">
                                    Product Details &amp; Specifications
                                </span>
                            </button>
                        </h2>
                        <div id="ss_collapse_details" class="accordion-collapse collapse show">
                            <div class="accordion-body">
                                <div t-field="product.website_description"
                                     class="mb-2 oe_structure"
                                     placeholder="Add a product description here."/>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-medium"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#ss_collapse_size"
                                    aria-expanded="false"
                                    aria-controls="ss_collapse_size">
                                <span class="ss-accordion-label">Size &amp; Fit</span>
                            </button>
                        </h2>
                        <div id="ss_collapse_size" class="accordion-collapse collapse">
                            <div class="accordion-body oe_structure"
                                 id="oe_structure_ss_size_fit"/>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-medium"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#ss_collapse_material"
                                    aria-expanded="false"
                                    aria-controls="ss_collapse_material">
                                <span class="ss-accordion-label">Material &amp; Care</span>
                            </button>
                        </h2>
                        <div id="ss_collapse_material" class="accordion-collapse collapse">
                            <div class="accordion-body oe_structure"
                                 id="oe_structure_ss_material"/>
                        </div>
                    </div>
                </div>
                <!-- Cross-sells: 4 cards inside left column -->
                <t t-set="cross_sells" t-value="product._sf_get_cross_sells(4)"/>
                <t t-if="cross_sells">
                    <div class="ss-crosssells-section mt-4 pt-4 border-top">
                        <h3 class="ss-crosssells-title mb-3">You might also like</h3>
                        <div class="row g-2">
                            <t t-foreach="cross_sells" t-as="item">
                                <t t-set="item_in_stock" t-value="item._sf_is_available()"/>
                                <div class="col-3">
                                    <div class="ss-crosssell-card">
                                        <a t-att-href="item.website_url" class="text-decoration-none">
                                            <div class="ss-crosssell-img-wrap">
                                                <img t-att-src="'/web/image/product.template/%s/image_512' % item.id"
                                                     t-att-alt="item.name"
                                                     loading="lazy"/>
                                            </div>
                                            <div class="ss-crosssell-body">
                                                <div class="ss-crosssell-name" t-esc="item.name"/>
                                                <div class="ss-crosssell-price">$<t t-esc="'%.2f' % item.list_price"/></div>
                                            </div>
                                        </a>
                                        <a t-att-href="item.website_url" class="ss-crosssell-btn">Add to bag</a>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </xpath>
    </template>

    <!-- Cross-sells full width below entire product section -->
    <template id="ss_product_description_crosssells"
              inherit_id="website_sale.product"
              name="SS: Cross-Sells Grid"
              priority="99">
        <xpath expr="//div[@id='product_detail_main']" position="after">

        </xpath>
    </template>

    <template id="shop_product_ss_grid"
              name="SS: Hero + Grid Image Layout"
              inherit_id="website_sale.shop_product_images"
              priority="20">
        <xpath expr="//t[@t-call]" position="replace">
            <t t-if="website and website.name == 'Sunglass Superstore'">
                <t t-if="product_images">
                    <div class="ss-hero-image mb-2 position-relative">
                        <t t-set="ribbon" t-value="product_variant.sudo().variant_ribbon_id or product.sudo().website_ribbon_id"/>
                        <span t-if="ribbon" t-attf-class="o_ribbon #{ribbon._get_position_class()} z-1"
                              t-attf-style="#{ribbon['text_color'] and ('color: %s; ' % ribbon['text_color'])}#{ribbon['bg_color'] and 'background-color:' + ribbon['bg_color']}"
                              t-out="ribbon['name'] or ''"/>
                        <img t-attf-src="/web/image/{{ product_images[0]._name }}/{{ product_images[0].id }}/image_1920"
                             class="w-100 ss-hero-img"
                             t-att-alt="product.name"
                             loading="eager"/>
                    </div>
                    <t t-if="len(product_images) > 1">
                        <div class="row g-2">
                            <t t-foreach="product_images[1:]" t-as="pimage">
                                <div class="col-6">
                                    <img t-attf-src="/web/image/{{ pimage._name }}/{{ pimage.id }}/image_1024"
                                         class="w-100 ss-grid-img"
                                         t-att-alt="product.name"
                                         loading="lazy"/>
                                </div>
                            </t>
                        </div>
                    </t>
                </t>
            </t>
            <t t-else="">
                <t t-call="website_sale.shop_product_#{website.product_page_image_layout}"/>
            </t>
        </xpath>
    </template>

</odoo>
