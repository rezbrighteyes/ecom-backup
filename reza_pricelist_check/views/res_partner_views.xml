<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_reza_check_prices" model="ir.ui.view">
        <field name="name">res.partner.form.reza.check.prices</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_reza_check_prices" type="object" class="oe_stat_button"
                        icon="sell" groups="product.group_product_pricelist"
                        invisible="parent_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Check Prices</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
