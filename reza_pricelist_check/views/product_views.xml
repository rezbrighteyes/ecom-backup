<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The reverse of Check Prices: one row per price list for this product. -->
    <record id="view_reza_pricelist_check_line_by_product" model="ir.ui.view">
        <field name="name">reza.pricelist.check.line.by.product</field>
        <field name="model">reza.pricelist.check.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Price Lists" create="0" edit="0" delete="0"
                  decoration-danger="status in ('zero', 'above', 'below_cost')"
                  decoration-muted="status in ('no_rule', 'same')">
                <header>
                    <button name="action_reza_exclude" type="object" string="Exclude from Discount"
                            groups="sales_team.group_sale_manager"
                            help="Adds a 0% rule for this product on each selected list, so it sells at the normal price there."/>
                    <button name="action_reza_allow" type="object" string="Allow Discount Again"
                            groups="sales_team.group_sale_manager"
                            help="Removes the 0% rules for this product on the selected lists, so their wider discount applies again."/>
                </header>
                <field name="pricelist_id"/>
                <field name="pricelist_company_id" optional="show"/>
                <field name="pricelist_website_id" optional="show"/>
                <field name="default_code" optional="hide"/>
                <field name="product_id" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="sale_price"/>
                <field name="price"/>
                <field name="cost" optional="hide"/>
                <field name="discount_pct" widget="percentage" decoration-danger="discount_pct &lt; 0"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'discount'"
                       decoration-danger="status in ('zero', 'above', 'below_cost')"
                       />
                <field name="rule_applied_on" string="Rule Is For"/>
                <field name="why"/>
                <field name="conflict" widget="badge" optional="show"
                       invisible="conflict == 'none'"
                       decoration-danger="conflict == 'conflict'"
                       decoration-muted="conflict == 'overlap'"/>
                <field name="conflict_text" optional="hide"/>
                <field name="rule_id" string="Rule Used" optional="hide"/>
                <button name="action_open_rule" type="object" icon="open_in_new"
                        title="Open the rule" invisible="not rule_id"/>
            </list>
        </field>
    </record>

    <record id="view_product_template_form_reza_price_lists" model="ir.ui.view">
        <field name="name">product.template.form.reza.price.lists</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_reza_price_lists" type="object" class="oe_stat_button"
                        icon="sell" groups="product.group_product_pricelist"
                        invisible="not id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Price Lists</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
