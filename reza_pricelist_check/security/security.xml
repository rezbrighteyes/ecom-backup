<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Each person sees only the checks they ran. -->
    <record id="rule_reza_pricelist_check_own" model="ir.rule">
        <field name="name">Price list check: own runs only</field>
        <field name="model_id" ref="model_reza_pricelist_check"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>
    <record id="rule_reza_pricelist_check_line_own" model="ir.rule">
        <field name="name">Price list check rows: own runs only</field>
        <field name="model_id" ref="model_reza_pricelist_check_line"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>
</odoo>
