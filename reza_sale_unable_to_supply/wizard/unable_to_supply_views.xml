<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_reza_unable_supply_wizard_form" model="ir.ui.view">
        <field name="name">reza.unable.supply.wizard.form</field>
        <field name="model">reza.unable.supply.wizard</field>
        <field name="arch" type="xml">
            <form string="Cannot Supply">
                <div class="alert alert-info" role="alert">
                    Enter how many of each item you cannot supply. Odoo lowers the
                    order, cancels that stock, and credits anything already invoiced.
                    It does <b>not</b> refund the money: do that in PayPal or Stripe.
                </div>
                <group>
                    <field name="order_id" force_save="1"/>
                    <field name="reason"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="sale_line_id" column_invisible="1" force_save="1"/>
                        <field name="product_id"/>
                        <field name="ordered_qty" string="Ordered"/>
                        <field name="delivered_qty" string="Delivered"/>
                        <field name="invoiced_qty" string="Invoiced"/>
                        <field name="price_unit" string="Unit Price"/>
                        <field name="max_qty" string="Max"/>
                        <field name="qty_to_remove"/>
                        <field name="product_uom" string="UoM" groups="uom.group_uom"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Remove and Credit"
                            class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
