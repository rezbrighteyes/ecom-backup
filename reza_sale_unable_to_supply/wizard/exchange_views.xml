<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_reza_exchange_wizard_form" model="ir.ui.view">
        <field name="name">reza.exchange.wizard.form</field>
        <field name="model">reza.exchange.wizard</field>
        <field name="arch" type="xml">
            <form string="Exchange">
                <div class="alert alert-info" role="alert">
                    For items that have NOT shipped. Enter how many to exchange and
                    pick the new product. If the price differs by less than $1, the
                    customer keeps the price they paid.
                </div>
                <group>
                    <field name="order_id" force_save="1"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="sale_line_id" column_invisible="1" force_save="1"/>
                        <field name="product_tmpl_id" column_invisible="1"/>
                        <field name="product_id"/>
                        <field name="ordered_qty" string="Ordered"/>
                        <field name="delivered_qty" string="Delivered"/>
                        <field name="price_unit" string="Unit Price"/>
                        <field name="qty_to_exchange"/>
                        <field name="new_product_id" options="{'no_create': True}"
                               context="{'search_default_product_tmpl_id': product_tmpl_id}"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Exchange"
                            class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
