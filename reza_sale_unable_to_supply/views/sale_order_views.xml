<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_reza_unable_to_supply" model="ir.ui.view">
        <field name="name">sale.order.form.reza.unable.to.supply</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_reza_unable_to_supply" type="object"
                        string="Cannot Supply" class="btn-secondary"
                        invisible="state != 'sale' or locked"
                        groups="sales_team.group_sale_salesman"/>
            </xpath>
        </field>
    </record>

</odoo>
