<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="rockos_homepage" inherit_id="website.homepage" name="Rockos Homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="rockos-home">
            </div>
        </xpath>
    </template>

    <template id="rockos_home_product_section" name="Rockos Homepage Product Section">
        <section class="rockos-product-section">
            <h2 t-out="section_title"/>
            <div class="rockos-home-product-grid" t-if="products">
                <a t-foreach="products"
                   t-as="product"
                   t-att-href="product.website_url"
                   class="rockos-home-product-card">
                    <!-- Odoo 20: _get_sales_prices lives on product.template, keyed by template id,
                         and takes the pricelist and fiscal position explicitly (as /shop does). -->
                    <t t-set="product_price_vals"
                       t-value="product._get_sales_prices(request.pricelist, request.fiscal_position, website).get(product.id, {})"/>
                    <img t-att-src="'/web/image/product.template/%s/image_512' % product.id"
                         t-att-alt="product.name"/>
                    <strong t-out="product.name"/>
                    <span t-if="product.rating_count" class="rockos-product-rating"><i class="oi oi-filled" data-icon="star"/> <t t-out="product.rating_avg" t-options="{'widget': 'float', 'precision': 1}"/> <small>(<t t-out="product.rating_count"/> reviews)</small></span>
                    <span class="rockos-product-price"
                          t-out="product_price_vals.get('price_reduce', product.list_price)"
                          t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                </a>
            </div>
            <p class="rockos-center" t-else="">Choose products in Website settings under Rockos Storefront.</p>
        </section>
    </template>
</odoo>
