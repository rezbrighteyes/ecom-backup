<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="rockos_layout_class" inherit_id="website.layout" name="Rockos: Layout Scope">
        <xpath expr="//head" position="inside">
            <link rel="stylesheet" type="text/css"
                  href="/rockos_website_theme/static/src/css/rockos.css?v=180160"/>
            <script defer="defer" type="text/javascript"
                    src="/rockos_website_theme/static/src/js/rockos.js?v=180110"/>
        </xpath>
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute name="class" add="rockos-site" separator=" "/>
        </xpath>
    </template>

    <template id="rockos_header" inherit_id="website.layout" name="Rockos: Header">
        <xpath expr="//header" position="replace">
            <header class="rockos-header">
                <div class="rockos-topbar">
                    <div class="container d-flex justify-content-between align-items-center">
                        <div class="d-flex gap-3 align-items-center">
                            <a t-att-href="website.rockos_facebook_url" target="_blank" aria-label="Rockos Facebook"><i class="fa fa-facebook"/></a>
                            <a t-att-href="website.rockos_instagram_url" target="_blank" aria-label="Rockos Instagram"><i class="fa fa-instagram"/></a>
                            <a href="/form/expression-of-interest">Expression of interest</a>
                        </div>
                        <div class="d-none d-lg-flex gap-4">
                            <a href="/about-us">About Us</a>
                            <a href="/footwear-sizing-chart">Footwear Sizing Chart</a>
                            <a href="/contactus">Contact Us</a>
                        </div>
                    </div>
                </div>
                <div class="rockos-mainbar">
                    <div class="container d-flex align-items-center gap-3">
                        <a href="/" class="rockos-logo">
                            <img src="/rockos_website_theme/static/src/img/rockos_symbol_logo.png" alt="Rockos"/>
                        </a>
                        <nav class="rockos-nav d-none d-xl-flex" aria-label="Product categories">
                            <t t-foreach="website.menu_id.child_id.filtered(lambda menu: menu.is_visible)" t-as="menu">
                                <div class="rockos-nav-item">
                                    <a t-att-href="menu._clean_url()">
                                        <span t-field="menu.name"/>
                                        <i t-if="menu.child_id.filtered(lambda child: child.is_visible)" class="fa fa-caret-down"/>
                                    </a>
                                    <div t-if="menu.child_id.filtered(lambda child: child.is_visible)" class="rockos-submenu">
                                        <a t-foreach="menu.child_id.filtered(lambda child: child.is_visible)"
                                           t-as="child"
                                           t-att-href="child._clean_url()">
                                            <span t-field="child.name"/>
                                        </a>
                                    </div>
                                </div>
                            </t>
                        </nav>
                        <div class="rockos-tools ms-auto d-flex align-items-center gap-2">
                            <form action="/shop" method="get" class="rockos-search d-none d-lg-flex">
                                <input name="search" type="search" placeholder="Enter your keyword"/>
                                <button type="submit" aria-label="Search"><i class="fa fa-search"/></button>
                            </form>
                            <a href="/web/login" class="rockos-tool"><i class="fa fa-user"/><span>Account</span></a>
                            <a href="/shop/cart" class="rockos-tool"><i class="fa fa-shopping-cart"/><span>Cart</span></a>
                            <button class="rockos-menu-toggle d-xl-none" type="button" aria-label="Toggle menu"><i class="fa fa-bars"/></button>
                        </div>
                    </div>
                    <div class="rockos-mobile-nav container d-xl-none">
                        <a t-foreach="website.menu_id.child_id.filtered(lambda menu: menu.is_visible)"
                           t-as="menu"
                           t-att-href="menu._clean_url()">
                            <span t-field="menu.name"/>
                        </a>
                    </div>
                </div>
            </header>
        </xpath>
    </template>

    <template id="rockos_footer" inherit_id="website.layout" name="Rockos: Footer">
        <xpath expr="//footer" position="before">
            <t t-if="request.httprequest.path == '/'">
                <section class="rockos-home-hero">
                    <img t-att-src="'/web/image/website/%s/rockos_hero_image' % website.id"
                         alt="Rockos hero banner"/>
                </section>
                <section class="rockos-category-section rockos-container">
                    <div class="oe_structure" id="rockos_categories_editable">
                        <h2>Welcome to Rocko's</h2>
                        <div class="rockos-category-grid">
                            <a t-att-href="website._rockos_category_url('Thongs')" class="rockos-category-card rockos-category-card-wide"><img src="/rockos_website_theme/static/src/img/86.png" alt="Thongs"/><span>Thongs</span></a>
                            <a t-att-href="website._rockos_category_url('Sunnies', search='sunglasses')" class="rockos-category-card"><img src="/rockos_website_theme/static/src/img/89.jpg" alt="Sunnies"/><span>Sunnies</span></a>
                            <a t-att-href="website._rockos_category_url('Technology')" class="rockos-category-card"><img src="/rockos_website_theme/static/src/img/91.png.webp" alt="Technology"/><span>Technology</span></a>
                            <a t-att-href="website._rockos_category_url('Hats')" class="rockos-category-card"><img src="/rockos_website_theme/static/src/img/88.png" alt="Hats"/><span>Hats</span></a>
                            <a t-att-href="website._rockos_category_url('Fishing', 'Outdoor')" class="rockos-category-card"><img src="/rockos_website_theme/static/src/img/90.png.webp" alt="Fishing"/><span>Fishing</span></a>
                            <a t-att-href="website._rockos_category_url('Little Tackers Thongs', 'Thongs', search='kids thongs')" class="rockos-category-card rockos-category-card-wide"><img src="/rockos_website_theme/static/src/img/93.png.webp" alt="Kids Footwear"/><span>Kids Footwear</span></a>
                        </div>
                    </div>
                </section>
                <section class="rockos-benefits">
                    <div class="rockos-container rockos-benefit-grid">
                        <div><i class="fa fa-truck"/><strong>Free Shipping</strong><span t-out="website.rockos_free_shipping_text"/></div>
                        <div><i class="fa fa-thumbs-up"/><strong>100% Satisfaction</strong><span>Guaranteed</span></div>
                        <div><i class="fa fa-life-ring"/><strong>Excellent</strong><span>Customer Support</span></div>
                        <div><i class="fa fa-lock"/><strong>100% Secure</strong><span>Payment System</span></div>
                    </div>
                </section>
                <section class="rockos-container rockos-home-content">
                    <div class="oe_structure" id="rockos_home_products_editable">
                        <t t-call="rockos_website_theme.rockos_home_product_section">
                            <t t-set="section_title">Best Sellers</t>
                            <t t-set="products" t-value="website._rockos_visible_products(website.rockos_best_seller_product_ids)"/>
                        </t>
                        <t t-call="rockos_website_theme.rockos_home_product_section">
                            <t t-set="section_title">New Arrivals</t>
                            <t t-set="products" t-value="website._rockos_visible_products(website.rockos_new_arrival_product_ids)"/>
                        </t>
                    </div>
                </section>
            </t>
        </xpath>
        <xpath expr="//footer" position="replace">
            <footer class="rockos-footer">
                <section class="rockos-newsletter">
                    <div class="container text-center">
                        <h2>Sign Up To Rockos Newsletter</h2>
                        <p>Stay up to date with any new product releases, special offers and more!</p>
                        <div class="oe_structure" id="rockos_newsletter_editable"></div>
                    </div>
                </section>
                <div class="container rockos-footer-grid">
                    <div>
                        <img class="rockos-footer-logo" src="/rockos_website_theme/static/src/img/website_logo.png" alt="Rockos"/>
                        <p>Australian owned and operated, bringing Rockos and other well-known brands to stores across Australia.</p>
                    </div>
                    <div>
                        <h3>Store Categories</h3>
                        <a t-foreach="website._rockos_top_categories()"
                           t-as="category"
                           t-att-href="website._rockos_category_href(category)"
                           t-out="category.name"/>
                    </div>
                    <div>
                        <h3>Information</h3>
                        <a href="/about-us">About Us</a>
                        <a href="/returns-policy">Returns Policy</a>
                        <a href="/contactus">Contact Us</a>
                        <a href="/shipping">Shipping Policy</a>
                        <a href="/privacy-policy">Privacy Policy</a>
                        <a href="/security-policy">Security Policy</a>
                        <a href="/form/expression-of-interest">Expression of Interest</a>
                        <a href="/footwear-sizing-chart">Footwear Sizing Chart</a>
                        <a href="/terms-and-conditions">Terms and Conditions</a>
                        <a href="/faq">FAQ</a>
                        <a href="/amrf">AMRF</a>
                    </div>
                    <div>
                        <h3>Contact Us</h3>
                        <a t-att-href="'tel:%s' % website.rockos_phone"><t t-out="website.rockos_phone"/></a>
                        <div class="d-flex gap-3 mt-3">
                            <a t-att-href="website.rockos_facebook_url" target="_blank"><i class="fa fa-facebook"/></a>
                            <a t-att-href="website.rockos_instagram_url" target="_blank"><i class="fa fa-instagram"/></a>
                        </div>
                    </div>
                </div>
                <div class="rockos-copyright text-center">Copyright © Rockos Australia. All rights reserved.</div>
            </footer>
        </xpath>
    </template>
</odoo>
