<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="stock_urgency" name="Smart Storefront - Stock Urgency"
              inherit_id="website_sale.product">
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="after">
            <t t-if="website.name != 'Sunglass Superstore'">
                <t t-set="stock_msg" t-value="product._sf_get_stock_message()"/>
                <div t-if="stock_msg" class="sf-stock-urgency mt-2 mb-2">
                    <span class="badge bg-warning text-dark">
                        <i class="fa fa-fire me-1"/>
                        <t t-out="stock_msg"/>
                    </span>
                </div>
            </t>
        </xpath>
    </template>

    <template id="trust_badges" name="Smart Storefront - Trust Badges"
              inherit_id="website_sale.product">
        <xpath expr="//div[@id='o_product_terms_and_share']" position="before">
            <t t-if="website.name != 'Sunglass Superstore'">
                <div class="sf-trust-row my-3">
                    <t t-set="ship_threshold" t-value="product._sf_get_shipping_threshold()"/>
                    <div class="row g-2">
                        <div class="col-4">
                            <div class="sf-trust-badge text-center p-2 rounded bg-light">
                                <i class="fa fa-truck mb-1 d-block" style="font-size: 18px; color: #1D9E75;"/>
                                <small class="text-muted d-block" style="font-size: 11px; line-height: 1.3;">Free shipping over $<t t-out="ship_threshold"/></small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="sf-trust-badge text-center p-2 rounded bg-light">
                                <i class="fa fa-refresh mb-1 d-block" style="font-size: 18px; color: #378ADD;"/>
                                <small class="text-muted d-block" style="font-size: 11px; line-height: 1.3;">30-day returns</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="sf-trust-badge text-center p-2 rounded bg-light">
                                <t t-set="sf_qty" t-value="product._sf_get_stock_qty()"/>
                                <i t-if="sf_qty &gt; 0" class="fa fa-check-circle mb-1 d-block" style="font-size: 18px; color: #1D9E75;"/>
                                <i t-else="" class="fa fa-times-circle mb-1 d-block" style="font-size: 18px; color: #E24B4A;"/>
                                <small class="text-muted d-block" style="font-size: 11px; line-height: 1.3;">
                                    <t t-if="sf_qty &gt; 0">In stock</t>
                                    <t t-else="">Out of stock</t>
                                </small>
                            </div>
                        </div>
                    </div>
                    <t t-set="sf_qty_check" t-value="product._sf_get_stock_qty()"/>
                    <div t-if="sf_qty_check &gt; 0" class="sf-delivery-estimate mt-2 p-2 rounded bg-light text-center">
                        <small class="text-muted">
                            <i class="fa fa-calendar-check-o me-1"/>
                            Estimated delivery: <strong class="text-dark"><t t-out="product._sf_get_delivery_date()"/></strong>
                        </small>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <template id="product_description_crosssells" name="Smart Storefront - Description and Cross-Sells"
              inherit_id="website_sale.product">
        <xpath expr="//div[@id='product_full_description']" position="replace" optional="True">
            <t t-if="product.website_description and website.name != 'Sunglass Superstore'">
                <section id="product_full_description" class="sf-product-details">
                    <div class="container">
                        <div class="sf-details-grid">
                            <div class="sf-details-main">
                                <div class="sf-details-header">
                                    <h2 class="sf-details-title">Product Information</h2>
                                </div>
                                <div class="sf-details-content" itemprop="description" t-field="product.website_description"/>
                            </div>
                            <aside class="sf-sidebar" id="sf_sidebar">
                                <t t-set="cross_sells" t-value="product._sf_get_cross_sells(4)"/>
                                <t t-if="cross_sells">
                                    <h3 class="sf-sidebar-title">You might also like</h3>
                                    <div class="sf-related-list">
                                        <t t-foreach="cross_sells" t-as="item">
                                            <t t-set="first_variant" t-value="item.product_variant_ids[:1]"/>
                                            <t t-if="first_variant">
                                                <div class="sf-related-item" t-att-data-product-id="first_variant.id" t-att-data-name="item.name" t-att-data-price="'$%.2f' % item.list_price">
                                                    <a t-att-href="item.website_url" class="sf-related-link">
                                                        <img t-att-src="'/web/image/product.template/%s/image_128' % item.id" class="sf-related-thumb" t-att-alt="item.name" loading="lazy"/>
                                                        <div class="sf-related-info">
                                                            <div class="sf-related-name" t-esc="item.name"/>
                                                            <div class="sf-related-price" t-if="item.list_price">
                                                                $<t t-esc="'%.2f' % item.list_price"/>
                                                            </div>
                                                        </div>
                                                    </a>
                                                    <button type="button" class="sf-add-cart" t-att-data-variant-id="first_variant.id" title="Add to cart">
                                                        <i class="fa fa-shopping-cart"/>
                                                    </button>
                                                </div>
                                            </t>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="">
                                    <h3 class="sf-sidebar-title">Why shop with us</h3>
                                    <div class="sf-trust-sidebar">
                                        <div class="sf-trust-row-item">
                                            <i class="fa fa-truck sf-trust-ico"/>
                                            <div>
                                                <strong>Fast Dispatch</strong>
                                                <small>Ships within 24 hours</small>
                                            </div>
                                        </div>
                                        <div class="sf-trust-row-item">
                                            <i class="fa fa-lock sf-trust-ico"/>
                                            <div>
                                                <strong>Secure Checkout</strong>
                                                <small>SSL encrypted payments</small>
                                            </div>
                                        </div>
                                        <div class="sf-trust-row-item">
                                            <i class="fa fa-refresh sf-trust-ico"/>
                                            <div>
                                                <strong>Easy Returns</strong>
                                                <small>30-day hassle free</small>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </aside>
                        </div>
                    </div>
                </section>
            </t>
        </xpath>
    </template>

    <!-- Sale Block — WhatYouNeed (website_id=4) product detail page -->
    <template id="reza_sale_badge" name="Smart Storefront - Sale Block"
              inherit_id="website_sale.product">
        <xpath expr="//t[@t-call='website_sale.product_price']" position="replace">
            <t t-if="request.website.id == 4 and combination_info.get('has_discounted_price') and (combination_info['list_price'] - combination_info['price']) &gt; 0">
                <t t-set="reza_saving" t-value="combination_info['list_price'] - combination_info['price']"/>
                <t t-set="reza_pct" t-value="round(reza_saving / combination_info['list_price'] * 100) if combination_info['list_price'] else 0"/>
                <div class="reza-sale-block mt-2 mb-3">
                    <div class="reza-sale-badge-wrap mb-2">
                        <span class="reza-sale-badge">
                            <t t-if="reza_saving &gt;= 20.0">SAVE $<t t-esc="'%.0f' % reza_saving"/></t>
                            <t t-else="">SAVE <t t-esc="reza_pct"/>%</t>
                        </span>
                    </div>
                    <div class="reza-price-row">
                        <span class="reza-sale-price"
                              t-esc="combination_info['price']"
                              t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        <del class="reza-original-price ms-2"
                             t-esc="combination_info['list_price']"
                             t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                    </div>
                    <span itemprop="price" style="display:none;" t-esc="combination_info['price']"/>
                    <span itemprop="priceCurrency" style="display:none;" t-esc="website.currency_id.name"/>
                </div>
            </t>
            <t t-else="">
                <t t-call="website_sale.product_price"/>
            </t>
        </xpath>
    </template>

</odoo>
