<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="drift_kart_landing_page" name="Drift Kart Pro Landing Page">
        <t t-call="website.layout">
            <t t-set="head">
                <script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
            </t>
            <t t-set="pageName" t-value="'drift-kart'"/>
            <div id="wrap" class="dk-page">

                <!-- HERO -->
                <section class="dk-hero">
                    <div class="dk-hero-inner">
                        <div class="dk-hero-text">
                            <p class="dk-label">Electric · 360° Drifting · 5 Editions</p>
                            <h1 class="dk-hero-headline">Drift Kart Pro</h1>
                            <p class="dk-hero-sub">25–30 km/h of pure adrenaline. Spin, slide and dominate with Bluetooth speakers, LED lights and 360° drifting capability.</p>
                            <div class="dk-speedometer-wrap" style="margin:0 0 32px;"></div>
                            <div class="dk-hero-stats">
                                <div class="dk-stat">
                                    <span class="dk-stat-val">30</span>
                                    <span class="dk-stat-unit">km/h</span>
                                    <span class="dk-stat-lbl">Top Speed</span>
                                </div>
                                <div class="dk-stat">
                                    <span class="dk-stat-val">10</span>
                                    <span class="dk-stat-unit">km</span>
                                    <span class="dk-stat-lbl">Range</span>
                                </div>
                                <div class="dk-stat">
                                    <span class="dk-stat-val">40</span>
                                    <span class="dk-stat-unit">min</span>
                                    <span class="dk-stat-lbl">Playtime</span>
                                </div>
                            </div>
                            <a href="/shop/drift-kart-pro-66892" class="dk-cta-primary">Shop Now — $549.99</a>
                        </div>
                        <div class="dk-hero-model">
                            <model-viewer
                                src="/web/content/382599?download=false"
                                alt="Drift Kart Pro 3D Model"
                                auto-rotate="true"
                                camera-controls="true"
                                shadow-intensity="1"
                                exposure="0.8"
                                style="width:100%;height:500px;background:transparent;">
                            </model-viewer>
                        </div>
                    </div>
                </section>

                <!-- FEATURES -->
                <section class="dk-features-section">
                    <div class="dk-container">
                        <h2 class="dk-section-title">Built for Performance</h2>
                        <div class="dk-features-grid">
                            <div class="dk-feature">
                                <div class="dk-feature-icon">&#9889;</div>
                                <h3>3-Speed Control</h3>
                                <p>Adjustable speed modes for beginners to pros. Full precision drifting at every level.</p>
                            </div>
                            <div class="dk-feature">
                                <div class="dk-feature-icon">&#127925;</div>
                                <h3>Bluetooth Speaker</h3>
                                <p>Built-in Bluetooth speaker and ambient atmosphere lighting for next-level rides.</p>
                            </div>
                            <div class="dk-feature">
                                <div class="dk-feature-icon">&#128260;</div>
                                <h3>360° Drifting</h3>
                                <p>PU flashing rear wheels designed for spins, slides and tricks on any smooth surface.</p>
                            </div>
                            <div class="dk-feature">
                                <div class="dk-feature-icon">&#128274;</div>
                                <h3>Key-Start Ignition</h3>
                                <p>Secure key-start with battery indicator. Safe and practical for everyday use.</p>
                            </div>
                            <div class="dk-feature">
                                <div class="dk-feature-icon">&#9881;</div>
                                <h3>Adjustable Frame</h3>
                                <p>Reinforced steel chassis with adjustable frame to fit different rider sizes comfortably.</p>
                            </div>
                            <div class="dk-feature">
                                <div class="dk-feature-icon">&#9889;</div>
                                <h3>Fast Charging</h3>
                                <p>2–4 hour fast charge gets you back on the track quickly. AU plug included.</p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- EDITIONS -->
                <section class="dk-editions-section">
                    <div class="dk-container">
                        <h2 class="dk-section-title dk-light">Choose Your Edition</h2>
                        <p class="dk-section-sub">5 limited edition designs. Same performance, different personality.</p>
                        <div class="dk-editions-grid">
                            <div class="dk-edition">
                                <img src="/web/image/product.product/81708/image_512" alt="Shadow Storm" class="dk-edition-img"/>
                                <h3 class="dk-edition-name">Shadow Storm</h3>
                                <p class="dk-edition-price">$549.99</p>
                                <a href="/shop/drift-kart-pro-66892#attribute_values=18350" class="dk-edition-btn">Shop Now</a>
                            </div>
                            <div class="dk-edition">
                                <img src="/web/image/product.product/81709/image_512" alt="Pink Crystal" class="dk-edition-img"/>
                                <h3 class="dk-edition-name">Pink Crystal</h3>
                                <p class="dk-edition-price">$549.99</p>
                                <a href="/shop/drift-kart-pro-66892#attribute_values=18351" class="dk-edition-btn">Shop Now</a>
                            </div>
                            <div class="dk-edition">
                                <img src="/web/image/product.product/81710/image_512" alt="Inferno Line" class="dk-edition-img"/>
                                <h3 class="dk-edition-name">Inferno Line</h3>
                                <p class="dk-edition-price">$549.99</p>
                                <a href="/shop/drift-kart-pro-66892#attribute_values=18352" class="dk-edition-btn">Shop Now</a>
                            </div>
                            <div class="dk-edition">
                                <img src="/web/image/product.product/81711/image_512" alt="Ice &amp; Fire" class="dk-edition-img"/>
                                <h3 class="dk-edition-name">Ice &amp; Fire</h3>
                                <p class="dk-edition-price">$549.99</p>
                                <a href="/shop/drift-kart-pro-66892#attribute_values=18353" class="dk-edition-btn">Shop Now</a>
                            </div>
                            <div class="dk-edition">
                                <img src="/web/image/product.product/81712/image_512" alt="Urban Rebel" class="dk-edition-img"/>
                                <h3 class="dk-edition-name">Urban Rebel</h3>
                                <p class="dk-edition-price">$549.99</p>
                                <a href="/shop/drift-kart-pro-66892#attribute_values=18354" class="dk-edition-btn">Shop Now</a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- TRUST -->
                <section class="dk-trust-section">
                    <div class="dk-container">
                        <div class="dk-trust-grid">
                            <div class="dk-trust-item">
                                <span class="dk-trust-icon">&#128666;</span>
                                <strong>Free Shipping</strong>
                                <span>On orders over $150</span>
                            </div>
                            <div class="dk-trust-item">
                                <span class="dk-trust-icon">&#128260;</span>
                                <strong>30-Day Returns</strong>
                                <span>Hassle-free returns</span>
                            </div>
                            <div class="dk-trust-item">
                                <span class="dk-trust-icon">&#128274;</span>
                                <strong>Secure Checkout</strong>
                                <span>SSL encrypted payments</span>
                            </div>
                            <div class="dk-trust-item">
                                <span class="dk-trust-icon">&#9889;</span>
                                <strong>Fast Dispatch</strong>
                                <span>Ships within 24 hours</span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- FINAL CTA -->
                <section class="dk-final-cta">
                    <div class="dk-container">
                        <h2>Ready to Drift?</h2>
                        <p>5 editions available now. Free shipping over $150.</p>
                        <a href="/shop/drift-kart-pro-66892" class="dk-cta-primary">Shop Drift Kart Pro</a>
                    </div>
                </section>

            </div>
        </t>
    </template>
</odoo>
