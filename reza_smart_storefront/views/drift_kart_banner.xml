<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="drift_kart_homepage_banner"
              name="WYN: Drift Kart Hero Banner"
              inherit_id="website.layout"
              priority="10">
        <xpath expr="//div[@id='wrapwrap']/main" position="before">
            <t t-if="website.name == 'WhatYouNeed' and request.httprequest.path == '/'">

                <!-- ── Trust badges ── -->
                <section class="wp-features" aria-label="Store highlights">
                    <div class="wp-features__grid">

                        <div class="wp-feature" data-feature="shipping">
                            <div class="wp-feature__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M3.5 7.5 12 3l8.5 4.5V17c0 .8-.4 1.5-1.1 1.9L12 22l-7.4-3.1c-.7-.3-1.1-1-1.1-1.9V7.5Z" stroke="currentColor" stroke-width="1.6"/>
                                    <path d="M12 22V12" stroke="currentColor" stroke-width="1.6"/>
                                    <path d="M3.5 7.5 12 12l8.5-4.5" stroke="currentColor" stroke-width="1.6"/>
                                </svg>
                            </div>
                            <div class="wp-feature__text">
                                <div class="wp-title"><span class="t1">Free Shipping</span></div>
                                <div class="wp-feature__sub">Over $150</div>
                            </div>
                        </div>

                        <div class="wp-feature" data-feature="payment">
                            <div class="wp-feature__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M4 7.5c0-1.1.9-2 2-2h11.5c1.4 0 2.5 1.1 2.5 2.5v8c0 1.4-1.1 2.5-2.5 2.5H6c-1.1 0-2-.9-2-2v-11Z" stroke="currentColor" stroke-width="1.6"/>
                                    <path d="M18 10h4v4h-4a2 2 0 0 1 0-4Z" stroke="currentColor" stroke-width="1.6"/>
                                    <path d="M18.6 12h.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <div class="wp-feature__text">
                                <div class="wp-title"><span class="t1">Buy Now</span></div>
                                <div class="wp-feature__sub">Pay Later</div>
                            </div>
                        </div>

                        <div class="wp-feature" data-feature="clients">
                            <div class="wp-feature__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M8 12a3 3 0 1 0-3-3 3 3 0 0 0 3 3Z" stroke="currentColor" stroke-width="1.6"/>
                                    <path d="M14 11.8a2.7 2.7 0 1 0-2.7-2.7A2.7 2.7 0 0 0 14 11.8Z" stroke="currentColor" stroke-width="1.6"/>
                                    <path d="M2.8 20.2c.8-3.1 3-5 5.2-5s4.4 1.9 5.2 5" stroke="currentColor" stroke-width="1.6"/>
                                    <path d="m19.2 13.2.6 1.4 1.5.1-1.1 1 .3 1.5-1.3-.8-1.3.8.3-1.5-1.1-1 1.5-.1.6-1.4Z" fill="currentColor"/>
                                </svg>
                            </div>
                            <div class="wp-feature__text">
                                <div class="wp-title wp-tight">
                                    <span class="t1" data-counter="1600">0</span><span class="t2">+</span>
                                </div>
                                <div class="wp-feature__sub">Satisfied clients</div>
                            </div>
                        </div>

                        <div class="wp-feature" data-feature="dispatch">
                            <div class="wp-feature__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M3 7.5h11v9H3v-9Z" stroke="currentColor" stroke-width="1.6"/>
                                    <path d="M14 10h4.5l2 2.5V16H14v-6Z" stroke="currentColor" stroke-width="1.6"/>
                                </svg>
                            </div>
                            <div class="wp-feature__text">
                                <div class="wp-title"><span class="t1">Quick</span></div>
                                <div class="wp-feature__sub">Dispatch</div>
                            </div>
                        </div>

                        <div class="wp-feature" data-feature="tracking">
                            <div class="wp-feature__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M6 3h12v18l-2-1-2 1-2-1-2 1-2-1-2 1V3Z" stroke="currentColor" stroke-width="1.6"/>
                                    <path d="M9 7h6M9 10h6" stroke="currentColor" stroke-width="1.6"/>
                                </svg>
                            </div>
                            <div class="wp-feature__text">
                                <div class="wp-title"><span class="t1">Real-Time</span></div>
                                <div class="wp-feature__sub">Tracking</div>
                            </div>
                        </div>

                        <div class="wp-feature" data-feature="support">
                            <div class="wp-feature__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none">
                                    <path d="M4 5.8C4 4.8 4.8 4 5.8 4h12.4C19.2 4 20 4 20 5.8v8.4c0 1-.8 1.8-1.8 1.8H10l-4.3 3v-3H5.8c-1 0-1.8-.8-1.8-1.8V5.8Z" stroke="currentColor" stroke-width="1.6"/>
                                    <path d="M8 9h8M8 12h6" stroke="currentColor" stroke-width="1.6"/>
                                </svg>
                            </div>
                            <div class="wp-feature__text">
                                <div class="wp-title"><span class="t1">Friendly</span></div>
                                <div class="wp-feature__sub">Support</div>
                            </div>
                        </div>

                    </div>
                </section>

                <!-- ── Drift Kart Banner ── -->
                <div class="wyn-drift-banner-wrap">
                    <section class="wyn-drift-banner">
                        <div class="wyn-drift-inner">
                            <div class="wyn-drift-content">
                                <p class="wyn-drift-label">Limited Time · 25% Off</p>
                                <h2 class="wyn-drift-headline">Drift. Slide.<br/>Dominate.</h2>
                                <p class="wyn-drift-sub">25–30 km/h · 360° Drifting · Bluetooth + LED · 5 Editions</p>
                                <a href="/drift-kart" class="wyn-drift-cta">Shop Now — 25% Off</a>
                            </div>
                        </div>
                    </section>
                </div>

            </t>
        </xpath>
    </template>
</odoo>