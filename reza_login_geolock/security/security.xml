<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Its own category, so on the user form it is a field of its own (under
         Administration) and never shares a dropdown with an unrelated group.
         Odoo 20: the group hangs off a res.groups.privilege inside that category. -->
    <record id="module_category_geolock" model="ir.module.category">
        <field name="name">Sign-in Geolock</field>
        <field name="parent_id" ref="base.module_category_administration"/>
        <field name="sequence">90</field>
    </record>

    <record id="privilege_geolock" model="res.groups.privilege">
        <field name="name">Sign-in Geolock</field>
        <field name="category_id" ref="module_category_geolock"/>
        <field name="sequence">90</field>
    </record>

    <record id="group_geolock_manager" model="res.groups">
        <field name="name">Sign-in Geolock Manager</field>
        <field name="privilege_id" ref="privilege_geolock"/>
        <field name="comment">Sees the staff sign-in geolock settings, its log and the per-user exemption. Administrator only.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
