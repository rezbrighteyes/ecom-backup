<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_geolock" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.reza.login.geolock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='user_default_rights']" position="after">
                <block title="Staff Sign-in Geolock" id="reza_login_geolock" groups="reza_login_geolock.group_geolock_manager">
                    <setting id="reza_geolock_mode_setting" string="Staff Sign-in Geolock"
                             help="Refuse staff (internal user) sign-ins from outside the allowed countries. Portal users and website visitors are never checked.">
                        <field name="reza_geolock_mode"/>
                        <div class="content-group mt8">
                            <label for="reza_geolock_countries" class="o_light_label me-2"/>
                            <field name="reza_geolock_countries" placeholder="AU"/>
                        </div>
                        <div class="mt8">
                            <button name="%(action_reza_login_geolock_event)d" type="action"
                                    string="Sign-in Geolock Log" icon="oi-arrow-right" class="btn-link"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
