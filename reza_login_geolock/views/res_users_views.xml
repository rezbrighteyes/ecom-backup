<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_geolock" model="ir.ui.view">
        <field name="name">res.users.form.reza.login.geolock</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <!-- Applied before auth_totp / auth_passkey (priority 16), which also
             fill the Account Security page, so the box sits at the top of the
             page: below the device list it was easy to miss. -->
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='account_security']" position="inside">
                <group string="Sign-in Geolock" name="reza_login_geolock" groups="reza_login_geolock.group_geolock_manager" invisible="share">
                    <field name="reza_geolock_exempt"/>
                    <field name="reza_geolock_ip_only"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
