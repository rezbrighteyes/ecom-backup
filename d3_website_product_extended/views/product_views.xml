<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_product_specs" model="ir.ui.view">
        <field name="name">product.template.form.product.specifications</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <page name="sales" position="inside">
                <group string="Ecommerce Product Data" name="d3_ecommerce_product_data">
                    <group>
                        <field name="d3_model_code"/>
                        <field name="d3_gender"/>
                        <field name="d3_warranty"/>
                    </group>
                    <group>
                        <field name="d3_store_range"/>
                        <field name="d3_online_range"/>
                        <field name="d3_clearance"/>
                        <field name="d3_discontinued"/>
                    </group>
                </group>
            </page>
            <page name="sales" position="after">
                <page string="Specifications / Filters" name="d3_specifications_filters">
                    <group>
                        <group string="Product Specifics">
                            <field name="d3_specific_size"/>
                            <field name="d3_specific_shape"/>
                            <field name="d3_lens_technology"/>
                            <field name="d3_lens_material"/>
                            <field name="d3_lens_colour"/>
                            <field name="d3_lens_category"/>
                            <field name="d3_frame_material"/>
                            <field name="d3_frame_colour"/>
                        </group>
                        <group string="Sizing">
                            <field name="d3_base_curve"/>
                            <field name="d3_bridge_size"/>
                            <field name="d3_lens_height"/>
                            <field name="d3_lens_width"/>
                            <field name="d3_temple_length"/>
                        </group>
                    </group>
                    <group string="Website Specification Visibility">
                        <field name="d3_hidden_website_spec_field_ids"
                               widget="many2many_tags"
                               domain="[('model', '=', 'product.template'), ('store', '=', True)]"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="d3_hidden_website_spec_field_names" invisible="1"/>
                    </group>
                </page>
            </page>
        </field>
    </record>

    <record id="view_product_template_purchase_buttons_from_variant_extended" model="ir.ui.view">
        <field name="name">product.template.purchase.button.inherit.variant.extended</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='variants']//field[@name='attribute_line_ids']/list/field[last()]" position="after">
                <field name="show_in_website" />
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_view_product_specs" model="ir.ui.view">
        <field name="name">product.template.list.product.specifications</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="d3_model_code" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="product_template_search_view_product_specs" model="ir.ui.view">
        <field name="name">product.template.search.product.specifications</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="d3_model_code"/>
            </field>
            <filter name="filter_to_purchase" position="after">
                <filter string="Clearance" name="d3_clearance" domain="[('d3_clearance', '=', True)]"/>
                <filter string="Discontinued" name="d3_discontinued" domain="[('d3_discontinued', '=', True)]"/>
                <filter string="Store Range" name="d3_store_range" domain="[('d3_store_range', '=', True)]"/>
                <filter string="Online Range" name="d3_online_range" domain="[('d3_online_range', '=', True)]"/>
            </filter>
        </field>
    </record>
</odoo>
