<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inheritd_website_product_extended" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website_product_extended</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale_stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='product_availability_setting']" position="after">
                <setting id="consider_all_related_warehouses_setting"
                         string="Consider All Related Warehouses"
                         help="Count the free stock of every warehouse of the parent companies.">
                    <field name="consider_all_related_warehouses"/>
                </setting>
                <setting id="shop_one_card_per_product_setting"
                         string="One Shop Card per Product"
                         help="When no attribute of a product is marked Show In Website, show one card for the product instead of one card per variant.">
                    <field name="shop_one_card_per_product"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>

