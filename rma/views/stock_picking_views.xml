<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <!-- Odoo 20 removed the return wizard; this opens the RMA
                     module's own one, which can also create RMAs. -->
                <button
                    name="%(rma.action_rma_return_picking)d"
                    string="Return / RMA"
                    type="action"
                    invisible="state != 'done' or picking_type_code not in ('outgoing', 'dropship')"
                    context="{'active_id': id, 'active_ids': [id], 'active_model': 'stock.picking'}"
                    groups="rma.rma_group_user_own"
                />
            </xpath>
            <div name="button_box">
                <button
                    name="action_view_rma"
                    type="object"
                    class="oe_stat_button"
                    icon="reply"
                    invisible="rma_count == 0"
                    groups="rma.rma_group_user_own"
                >
                    <field name="rma_count" widget="statinfo" string="RMA" />
                </button>
            </div>
        </field>
    </record>
</odoo>
