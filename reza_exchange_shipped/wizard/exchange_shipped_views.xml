<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_reza_exchange_shipped_wizard_form" model="ir.ui.view">
        <field name="name">reza.exchange.shipped.wizard.form</field>
        <field name="model">reza.exchange.shipped.wizard</field>
        <field name="arch" type="xml">
            <form string="Exchange (shipped)">
                <div class="alert alert-info" role="alert">
                    For items the customer has SENT BACK. Use it once the item is in the shed.
                    Enter how many came back and pick the replacement (it can be the same
                    product). The replacement goes on a new order. If the price differs by
                    less than $1, the customer keeps the price they paid.
                </div>
                <group>
                    <field name="order_id" force_save="1"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="sale_line_id" column_invisible="1" force_save="1"/>
                        <field name="product_tmpl_id" column_invisible="1"/>
                        <field name="product_id"/>
                        <field name="delivered_qty" string="Delivered"/>
                        <field name="price_unit" string="Unit Price"/>
                        <field name="qty_to_exchange"/>
                        <field name="new_product_id" options="{'no_create': True}"
                               context="{'search_default_product_tmpl_id': product_tmpl_id}"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Exchange"
                            class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
