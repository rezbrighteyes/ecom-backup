<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_reza_refund_shipped_wizard_form" model="ir.ui.view">
        <field name="name">reza.refund.shipped.wizard.form</field>
        <field name="model">reza.refund.shipped.wizard</field>
        <field name="arch" type="xml">
            <form string="Refund (shipped)">
                <div class="alert alert-info" role="alert">
                    For items the customer has SENT BACK for their money. Use it once the items
                    are in the shed. Enter how many came back. Odoo receives them, makes the
                    credit note at the price the customer paid, and sends them back to Edbert.
                </div>
                <div class="alert alert-info" role="alert" invisible="not not_coming_back">
                    Not coming back (lost parcel, or the customer keeps a faulty item): enter how
                    many to refund. Odoo scraps them, makes the credit note and the refund
                    task. Nothing goes into stock and nothing goes back to Edbert. Put the
                    Aus Post enquiry number in the reason.
                </div>
                <div class="alert alert-warning" role="alert" invisible="auto_refund">
                    Odoo does not send the money. The refund user gets a task with the exact
                    amount, and Odoo checks Stripe or PayPal every day until it is refunded.
                </div>
                <div class="alert alert-warning" role="alert" invisible="not auto_refund">
                    A Stripe payment is refunded by Odoo as soon as you click Refund.
                    PayPal is still refunded by hand.
                </div>
                <group>
                    <field name="order_id" force_save="1"/>
                    <field name="reason"/>
                    <field name="refund_shipping"/>
                    <field name="not_coming_back"/>
                    <field name="auto_refund" invisible="1"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="sale_line_id" column_invisible="1" force_save="1"/>
                        <field name="product_id"/>
                        <field name="delivered_qty" string="Delivered"/>
                        <field name="price_unit" string="Unit Price"/>
                        <field name="qty_to_return"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Refund" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
