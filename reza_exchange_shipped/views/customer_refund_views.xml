<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_reza_customer_refund_list" model="ir.ui.view">
        <field name="name">reza.customer.refund.list</field>
        <field name="model">reza.customer.refund</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="state in ('late', 'mismatch')"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="create_date" string="Started"/>
                <field name="sale_order_id"/>
                <field name="credit_note_id"/>
                <field name="provider_code" string="Paid With"/>
                <field name="amount" sum="Total"/>
                <field name="refunded_amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="refund_date"/>
                <field name="state"/>
                <field name="note"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_reza_customer_refund_form" model="ir.ui.view">
        <field name="name">reza.customer.refund.form</field>
        <field name="model">reza.customer.refund</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_check" type="object" string="Check now"
                            invisible="state == 'done'" groups="account.group_account_invoice"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="sale_order_id"/>
                            <field name="credit_note_id"/>
                            <field name="amount"/>
                            <field name="refunded_amount"/>
                            <field name="refund_date"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="provider_code" string="Paid With"/>
                            <field name="provider_reference"/>
                            <field name="provider_refund_ids"/>
                            <field name="odoo_refund_tx_id"/>
                            <field name="last_check"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_reza_customer_refund_search" model="ir.ui.view">
        <field name="name">reza.customer.refund.search</field>
        <field name="model">reza.customer.refund</field>
        <field name="arch" type="xml">
            <search>
                <field name="sale_order_id"/>
                <field name="credit_note_id"/>
                <filter name="open" string="Not refunded yet" domain="[('state', '!=', 'done')]"/>
                <filter name="problem" string="Needs attention"
                        domain="[('state', 'in', ('late', 'mismatch'))]"/>
            </search>
        </field>
    </record>

    <record id="action_reza_customer_refund" model="ir.actions.act_window">
        <field name="name">Customer Refunds</field>
        <field name="res_model">reza.customer.refund</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <menuitem id="menu_reza_customer_refund" name="Customer Refunds"
              parent="sale.sale_order_menu" action="action_reza_customer_refund"
              sequence="90" groups="sales_team.group_sale_salesman"/>

    <record id="res_config_settings_view_form_reza_refund" model="ir.ui.view">
        <field name="name">res.config.settings.form.reza.refund</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Customer Refunds" name="reza_customer_refunds">
                    <setting string="Send refunds through Odoo"
                             help="Off: the refund user gets a task and refunds in Stripe or PayPal. On: Refund (shipped) refunds Stripe payments itself. A daily check confirms every refund either way.">
                        <field name="reza_refund_auto"/>
                    </setting>
                    <setting string="Refunds done by" help="Who gets the 'Refund $X' task.">
                        <field name="reza_refund_user_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
