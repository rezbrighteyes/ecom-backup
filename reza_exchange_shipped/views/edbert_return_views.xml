<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_reza_edbert_return_form" model="ir.ui.view">
        <field name="name">reza.edbert.return.form</field>
        <field name="model">reza.edbert.return</field>
        <field name="arch" type="xml">
            <form string="Edbert Return" create="0" edit="0" delete="0">
                <header>
                    <button name="action_retry" type="object" string="Retry"
                            class="btn-primary" invisible="state == 'done'"
                            groups="purchase.group_purchase_user"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <div class="alert alert-warning" role="alert" invisible="not note">
                        <field name="note"/>
                    </div>
                    <group>
                        <group>
                            <field name="sale_order_id"/>
                            <field name="purchase_id"/>
                            <field name="product_id"/>
                            <field name="qty"/>
                            <field name="attempts"/>
                        </group>
                        <group>
                            <field name="local_return_id"/>
                            <field name="remote_return_name"/>
                            <field name="vendor_refund_id"/>
                            <field name="remote_refund_name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_reza_edbert_return_list" model="ir.ui.view">
        <field name="name">reza.edbert.return.list</field>
        <field name="model">reza.edbert.return</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="state in ('failed', 'mismatch')"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="product_id"/>
                <field name="qty"/>
                <field name="state"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_reza_edbert_return" model="ir.actions.act_window">
        <field name="name">Edbert Returns</field>
        <field name="res_model">reza.edbert.return</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_reza_edbert_return" name="Edbert Returns"
              parent="sale.sale_order_menu" action="action_reza_edbert_return"
              sequence="90" groups="sales_team.group_sale_salesman"/>

</odoo>
