<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: a later upgrade must not re-enable a cron somebody switched off. -->
    <data noupdate="1">
        <record id="ir_cron_reza_edbert_return" model="ir.cron">
            <field name="name">Edbert: send exchanged items back</field>
            <field name="model_id" ref="model_reza_edbert_return"/>
            <field name="state">code</field>
            <field name="code">model._cron_process()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <!-- Active: it only ever acts on rows the Exchange (shipped)
                 button created, so it does nothing until that is used. -->
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
        <record id="ir_cron_reza_customer_refund_check" model="ir.cron">
            <field name="name">Customer refunds: check Stripe and PayPal</field>
            <field name="model_id" ref="model_reza_customer_refund"/>
            <field name="state">code</field>
            <field name="code">model._cron_check()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- Active: read-only against the providers, and only for rows
                 Refund (shipped) created. -->
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
        <record id="ir_cron_reza_customer_refund_send" model="ir.cron">
            <field name="name">Customer refunds: send queued Stripe refunds</field>
            <field name="model_id" ref="model_reza_customer_refund"/>
            <field name="state">code</field>
            <field name="code">model._cron_send()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <!-- Active, but a row is only ever queued while "Send refunds
                 through Odoo" is on, so it sends nothing until then. -->
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
